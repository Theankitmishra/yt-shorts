# Optional LLM providers for deeper semantic critique & hook rewriting.
# Leave blank to run 100% zero-cost offline (Local Signal + Transcript RSI) or use Ollama!

# Free local LLM via Ollama (http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Free Cloud Whisper + Llama 3.3 via Groq (0% local CPU/GPU — free key at console.groq.com)
GROQ_API_KEY=

# Optional Cloud APIs (only used if selected in UI or set here)
GEMINI_API_KEY=
OPENAI_API_KEY=
